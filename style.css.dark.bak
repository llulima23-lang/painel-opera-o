/* ═══════════════════════════════════════════════════════════
   PAINEL OPERAÇÕES — DARK MODE / GLASSMORPHISM / 3D
   ═══════════════════════════════════════════════════════════ */

:root {
    --primary:      #7c3aed;
    --primary-h:    #6d28d9;
    --primary-glow: rgba(124,58,237,.35);
    --accent:       #06b6d4;
    --accent-glow:  rgba(6,182,212,.25);
    --bg-main:      #0f0f1a;
    --bg-card:      rgba(255,255,255,.05);
    --bg-glass:     rgba(255,255,255,.06);
    --bg-glass-h:   rgba(255,255,255,.10);
    --text-main:    #e2e8f0;
    --text-muted:   #94a3b8;
    --text-bright:  #f8fafc;
    --border:       rgba(255,255,255,.08);
    --border-glow:  rgba(124,58,237,.25);
    --success:      #34d399;
    --success-bg:   rgba(52,211,153,.12);
    --warning:      #fbbf24;
    --warning-bg:   rgba(251,191,36,.12);
    --danger:       #f87171;
    --danger-bg:    rgba(248,113,113,.12);
    --sidebar-bg:   #0a0a14;
    --card-radius:  18px;
    --glass-blur:   16px;
}

* { margin:0; padding:0; box-sizing:border-box; font-family:'Outfit', sans-serif; }
body {
    background: var(--bg-main);
    color: var(--text-main);
    height: 100vh;
    overflow: hidden;
}

/* ── LOGIN SCREEN ── */
#login-screen {
    position:fixed; inset:0;
    background: linear-gradient(135deg, #0f0f1a 0%, #1a0a2e 50%, #0d1b2a 100%);
    display:flex; align-items:center; justify-content:center; z-index:2000;
}
.login-card {
    background: rgba(255,255,255,.06);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding:44px 40px; border-radius:24px;
    border: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 24px 60px rgba(0,0,0,.5), 0 0 60px rgba(124,58,237,.1);
    max-width:420px; width:100%;
    animation:fadeUp .5s ease;
}
.login-logo-icon {
    width:72px; height:72px;
    background:linear-gradient(135deg,#7c3aed,#06b6d4);
    border-radius:20px; font-size:24px; font-weight:800; color:#fff;
    display:flex; align-items:center; justify-content:center; margin:0 auto;
    letter-spacing:2px;
    box-shadow: 0 8px 30px rgba(124,58,237,.4);
}
.login-logo-icon span { color:#fbbf24; }
.form-group { display:flex; flex-direction:column; gap:6px; }
.form-group label { font-size:12px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; }
.form-group input {
    padding:14px 18px; border:1px solid rgba(255,255,255,.12); border-radius:12px;
    background:rgba(255,255,255,.06); color:var(--text-bright);
    font-size:16px; outline:none; letter-spacing:3px; transition:all .3s;
    backdrop-filter: blur(8px);
}
.form-group input::placeholder { color: rgba(255,255,255,.3); }
.form-group input:focus { border-color:var(--primary); box-shadow: 0 0 20px var(--primary-glow); }

/* ── LOGOUT ── */
.btn-logout {
    background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); color:#94a3b8;
    padding:10px 14px; border-radius:10px; font-size:12px; cursor:pointer; width:100%;
    transition:all .3s;
}
.btn-logout:hover { background:rgba(255,255,255,.1); color:#fff; border-color:var(--primary); }

/* ── SECTION TITLE ── */
.section-title {
    font-size:15px; font-weight:700; color:var(--text-bright); margin-bottom:16px;
    display:flex; align-items:center; gap:8px;
}

/* ── BH MINI GRID (no card) ── */
.bh-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:2px; }
.bh-item { background:rgba(255,255,255,.04); border-radius:10px; padding:10px 12px; }
.bh-item.bh-cred { border-left:3px solid var(--success); }
.bh-item.bh-def  { border-left:3px solid var(--danger); }
.bh-item.bh-fer  { border-left:3px solid var(--warning); }
.bh-item.bh-saldo{ grid-column:1/-1; background:rgba(124,58,237,.08); border-left:3px solid var(--primary); }
.bh-label { font-size:10px; color:var(--text-muted); font-weight:600; margin-bottom:3px; text-transform:uppercase; letter-spacing:.5px; }
.bh-val   { font-size:15px; font-weight:700; }

/* ── MOTIVATIONAL PANEL ── */
.motivational-container {
    display:flex; gap:16px; align-items:center; justify-content:center; margin-bottom:16px;
    animation:fadeUp .4s ease;
}
.status-card {
    flex:none; width:100%; max-width:650px; display:flex; gap:18px; padding:20px 24px; align-items:center;
    border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,.3);
    background:var(--bg-glass); backdrop-filter:blur(var(--glass-blur));
    border:1px solid var(--border); border-left:6px solid var(--primary);
}
.status-card.good { border-left-color:var(--success); }
.status-card.alert { border-left-color:var(--warning); }
.status-card.bad { border-left-color:var(--danger); }
.status-img {
    width:80px; height:80px; border-radius:14px; object-fit:cover;
    flex-shrink:0; background:rgba(255,255,255,.05);
}
.status-content { flex:1; display:flex; flex-direction:column; justify-content:center; }
.status-title { font-size:20px; font-weight:700; margin-bottom:6px; }
.status-card.good .status-title { color:var(--success); }
.status-card.alert .status-title { color:var(--warning); }
.status-card.bad .status-title { color:var(--danger); }
.status-details { font-size:14px; color:var(--text-muted); display:flex; flex-direction:column; gap:4px; line-height:1.4; }
.status-details span strong { font-weight:600; }
.status-good-text { color:var(--success); }
.status-bad-text { color:var(--danger); }

.quote-card {
    display:flex; flex-direction:column; align-items:center; gap:20px; padding:32px 24px; text-align:center;
    border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,.3);
    background:linear-gradient(135deg, rgba(124,58,237,.08), rgba(6,182,212,.08));
    border:1px solid rgba(124,58,237,.15); justify-content:center;
    animation:fadeUp .3s ease;
}
.quote-img {
    width:280px; height:280px; border-radius:18px; object-fit:cover; flex-shrink:0;
    animation:float 4s ease-in-out infinite;
    box-shadow: 0 8px 30px rgba(0,0,0,.4);
}
@keyframes float {
    0%   { transform:translateY(0) scale(1);    box-shadow:0 4px 10px rgba(0,0,0,.2); }
    50%  { transform:translateY(-12px) scale(1.04); box-shadow:0 20px 40px rgba(0,0,0,.3); }
    100% { transform:translateY(0) scale(1);    box-shadow:0 4px 10px rgba(0,0,0,.2); }
}
.quote-text { font-size:22px; color:var(--accent); font-style:italic; line-height:1.4; font-weight:700; max-width:85%; }

/* ── LOADING ── */
#loading-screen {
    position:fixed; inset:0;
    background: linear-gradient(135deg,#0f0f1a,#1a0a2e);
    display:flex; align-items:center; justify-content:center; z-index:1000;
}
.loader {
    width:44px; height:44px; border:3px solid rgba(255,255,255,.1);
    border-top-color:var(--primary); border-radius:50%;
    animation:spin 1s linear infinite;
}
.logo h2 { font-size:26px; font-weight:700; color:var(--text-bright); }
.logo span { color:var(--primary); }
@keyframes spin  { to { transform:rotate(360deg); } }
@keyframes fadeUp { from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)} }

/* ── BUTTONS ── */
.primary-btn {
    background:linear-gradient(135deg,var(--primary),#a855f7);
    color:#fff; border:none; padding:10px 18px; border-radius:11px;
    font-size:14px; font-weight:600; cursor:pointer; transition:all .3s;
    box-shadow: 0 4px 15px var(--primary-glow);
}
.primary-btn:hover { transform:translateY(-1px); box-shadow:0 6px 25px var(--primary-glow); }
.primary-btn.green { background:linear-gradient(135deg,#059669,#34d399); box-shadow:0 4px 15px rgba(52,211,153,.3); }
.primary-btn.green:hover { box-shadow:0 6px 25px rgba(52,211,153,.4); }
.btn-link { background:none; border:none; color:var(--accent); font-size:13px; cursor:pointer; text-decoration:underline; padding:0 6px; }

/* ── APP LAYOUT ── */
#app-wrapper { display:flex; height:100%; overflow:hidden; }

/* ── SIDEBAR ── */
.sidebar {
    width:210px; min-width:210px;
    background: linear-gradient(180deg, #0a0a14 0%, #110a20 100%);
    color:#f1f5f9; display:flex; flex-direction:column;
    border-right:1px solid rgba(255,255,255,.05);
}
.logo-sidebar { padding:22px 20px; text-align:center; border-bottom:1px solid rgba(255,255,255,.06); }
.logo-sidebar h2 { font-size:24px; font-weight:800; letter-spacing:4px; }
.logo-sidebar span { color:var(--accent); }
.nav-links { list-style:none; padding:14px 0; flex:1; }
.nav-links li {
    padding:13px 20px; display:flex; align-items:center; gap:11px; cursor:pointer;
    color:#64748b; border-left:3px solid transparent; transition:all .25s; font-size:14px;
}
.nav-links li:hover { background:rgba(124,58,237,.08); color:var(--text-bright); }
.nav-links li.active { background:rgba(124,58,237,.15); color:#fff; border-left-color:var(--primary); }
.sidebar-footer { padding:14px 18px; border-top:1px solid rgba(255,255,255,.05); margin-top:auto; }

/* ── CONTENT AREA ── */
.content-area { flex:1; display:flex; flex-direction:column; overflow:hidden; }

/* ── TOPBAR ── */
.topbar {
    background: rgba(255,255,255,.03);
    backdrop-filter: blur(12px);
    border-bottom:1px solid var(--border);
    padding:10px 22px; display:flex; align-items:center; gap:14px;
    flex-wrap:wrap; position:sticky; top:0; z-index:10;
}
.topbar-title h1 { font-size:18px; font-weight:700; white-space:nowrap; color:var(--text-bright); }
.global-filters { display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap; flex:1; justify-content:flex-end; }
.filter-item { display:flex; flex-direction:column; gap:3px; }
.filter-item label { font-size:10px; color:var(--text-muted); font-weight:600; text-transform:uppercase; letter-spacing:.6px; }
.filter-item select, .filter-item input {
    padding:7px 12px; border:1px solid var(--border); border-radius:10px;
    background:rgba(255,255,255,.05); color:var(--text-main);
    font-size:13px; outline:none; min-width:110px; transition:all .3s;
}
.filter-item input { min-width:130px; }
.filter-item select:focus, .filter-item input:focus { border-color:var(--primary); box-shadow:0 0 12px var(--primary-glow); }
.filter-item select option { background:#1e1b4b; color:#e2e8f0; }

/* ── MAIN (scroll) ── */
.main-content { flex:1; overflow-y:auto; }
.main-content::-webkit-scrollbar { width:5px; }
.main-content::-webkit-scrollbar-track { background:transparent; }
.main-content::-webkit-scrollbar-thumb { background:rgba(124,58,237,.3); border-radius:3px; }

/* ── VIEW SECTIONS ── */
.view-section { padding:16px 24px; animation:fadeUp .35s ease; }

/* ── KPI GRID (Dashboard) ── */
.kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:22px; }
.kpi-card {
    background: var(--bg-glass);
    backdrop-filter: blur(var(--glass-blur));
    padding:20px; border-radius:var(--card-radius);
    border: 1px solid var(--border);
    box-shadow: 0 4px 20px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.05);
    display:flex; align-items:flex-start; gap:14px;
    transition:transform .3s, box-shadow .3s;
}
.kpi-card:hover { transform:translateY(-3px) scale(1.01); box-shadow:0 8px 35px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.08); }
.kpi-icon {
    width:46px; height:46px; border-radius:13px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.kpi-info h3 { font-size:10px; color:var(--text-muted); font-weight:600; text-transform:uppercase; letter-spacing:.6px; margin-bottom:4px; }
.kpi-info .value { font-size:24px; font-weight:800; background:linear-gradient(135deg,var(--text-bright),var(--text-muted)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.kpi-info .target { font-size:11px; color:var(--text-muted); margin-top:2px; }

/* ═══════════════════════════════════════════════════════════
   OPERATOR CARDS — PREMIUM 3D GLASSMORPHISM
   ═══════════════════════════════════════════════════════════ */
.cards-grid {
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(340px,1fr));
    gap:20px;
}

.op-card {
    background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius:var(--card-radius);
    padding:0;
    border:1px solid rgba(255,255,255,.08);
    position:relative; overflow:hidden;
    transition:transform .35s cubic-bezier(.22,.68,0,1.3), box-shadow .35s;
    animation:fadeUp .4s ease;
    box-shadow:
        0 4px 24px rgba(0,0,0,.25),
        0 0 0 1px rgba(255,255,255,.03),
        inset 0 1px 0 rgba(255,255,255,.06);
}
.op-card:hover {
    transform:translateY(-6px) scale(1.015);
    box-shadow:
        0 16px 50px rgba(0,0,0,.35),
        0 0 40px var(--primary-glow),
        inset 0 1px 0 rgba(255,255,255,.1);
}
.op-card::before {
    content:'';
    position:absolute; top:0; left:0; right:0; height:4px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    opacity:.7;
}
.op-card.meta-batida::before {
    background: linear-gradient(90deg, #f59e0b, #fbbf24, #f97316);
    opacity:1;
}

.meta-badge {
    position:absolute; top:14px; right:14px;
    background:linear-gradient(135deg,#f59e0b,#fbbf24);
    color:#78350f;
    padding:5px 14px; border-radius:20px; font-size:12px; font-weight:800;
    box-shadow:0 4px 15px rgba(245,158,11,.5); letter-spacing:.5px;
    z-index:2;
}

/* ── Card Header with Avatar ── */
.op-header {
    display:flex; align-items:center; gap:14px;
    padding:20px 20px 0 20px;
    margin-bottom:16px;
}
.op-avatar {
    width:56px; height:56px; border-radius:50%;
    border:2px solid rgba(124,58,237,.4);
    box-shadow: 0 0 20px rgba(124,58,237,.2);
    object-fit:cover; flex-shrink:0;
    background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(6,182,212,.2));
}
.op-avatar-initials {
    width:56px; height:56px; border-radius:50%;
    border:2px solid rgba(124,58,237,.4);
    box-shadow: 0 0 20px rgba(124,58,237,.2);
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,#7c3aed,#06b6d4);
    color:#fff; font-size:18px; font-weight:800; letter-spacing:1px;
    flex-shrink:0;
}
.op-header-info { flex:1; min-width:0; }
.op-header-info h3 { font-size:16px; font-weight:700; color:var(--text-bright); line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.op-header-info p { font-size:11px; color:var(--text-muted); margin-top:3px; display:flex; flex-wrap:wrap; align-items:center; gap:4px; }

.tag-mat { display:inline-block; background:rgba(124,58,237,.15); color:#a78bfa; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:600; }
.tag-op  { display:inline-block; background:rgba(52,211,153,.12); color:#34d399; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:600; }

/* ── Metrics Section ── */
.metrics-section {
    padding:0 20px 16px 20px;
}
.section-label {
    font-size:10px; font-weight:700; text-transform:uppercase;
    letter-spacing:.8px; color:var(--text-muted); margin-bottom:12px;
    padding-top:12px; border-top:1px solid var(--border);
}

/* ── Metric Items (modern mini-cards) ── */
.op-metrics-grid {
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:8px;
}
.metric-item {
    background:rgba(255,255,255,.03);
    border:1px solid rgba(255,255,255,.05);
    border-radius:12px;
    padding:10px 12px;
    transition:all .25s;
}
.metric-item:hover {
    background:rgba(255,255,255,.06);
    border-color:rgba(124,58,237,.2);
    box-shadow: 0 0 15px rgba(124,58,237,.1);
}
.metric-item.full-width {
    grid-column: 1 / -1;
}
.metric-label {
    font-size:10px; font-weight:600; text-transform:uppercase;
    letter-spacing:.5px; color:var(--text-muted); margin-bottom:4px;
}
.metric-val {
    font-size:16px; font-weight:700; color:var(--text-bright);
}
.metric-sub {
    font-size:10px; color:var(--text-muted); margin-top:2px;
}

/* ── Progress Bar ── */
.progress-bar-wrap { width:100%; height:5px; background:rgba(255,255,255,.06); border-radius:3px; margin:6px 0 4px; overflow:hidden; }
.progress-bar { height:100%; border-radius:3px; transition:width .8s cubic-bezier(.22,.68,0,1); box-shadow: 0 0 8px currentColor; }

/* ── Old metric styles (kept for backwards compat) ── */
.op-metric { display:flex; justify-content:space-between; align-items:center; font-size:13px; margin-bottom:8px; }
.op-metric .label { color:var(--text-muted); }
.op-metric .val   { font-weight:600; text-align:right; }

.saldo-final { border-top:1px solid var(--border); padding-top:8px; margin-top:4px; }

/* ── Bank Box ── */
.charts-container { background:var(--bg-glass); backdrop-filter:blur(var(--glass-blur)); padding:20px 22px; border-radius:var(--card-radius); border:1px solid var(--border); box-shadow:0 4px 20px rgba(0,0,0,.2); }
.charts-container h3 { font-size:15px; font-weight:600; margin-bottom:12px; color:var(--text-bright); }
.stat-row { display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border); }
.stat-row:last-child { border-bottom:none; }
.stat-row span { color:var(--text-muted); font-size:13px; }
.stat-row strong { font-size:15px; font-weight:700; }
/* ── ABS por Operação ── */
.abs-operacao-container {
    display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:10px;
    margin-bottom:22px;
}
.abs-op-item {
    background:var(--bg-glass); backdrop-filter:blur(var(--glass-blur));
    border:1px solid var(--border); border-radius:12px;
    padding:14px 16px; display:flex; justify-content:space-between; align-items:center;
    transition:all .3s;
}
.abs-op-item:hover { background:rgba(255,255,255,.08); border-color:rgba(124,58,237,.2); transform:translateY(-2px); }
.abs-op-name { font-size:12px; color:var(--text-muted); font-weight:600; }
.abs-op-val { font-size:18px; font-weight:800; }

.text-success { color:var(--success)!important; }
.text-danger  { color:var(--danger)!important; }
.text-warning { color:var(--warning)!important; }

/* ── Responsive ── */
@media (max-width:768px) {
    .sidebar { width:60px; min-width:60px; }
    .sidebar span { display:none; }
    .logo-sidebar h2 { font-size:18px; }
    .cards-grid { grid-template-columns:1fr; }
    .kpi-grid { grid-template-columns:1fr 1fr; }
    .op-metrics-grid { grid-template-columns:1fr; }
}

